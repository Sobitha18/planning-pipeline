# Copy to .env (git-ignored) and fill in. Real environment variables win over .env.

# --- required ---
DATABASE_URL=postgresql+psycopg://<user>@localhost:5432/multirepo
LLM_API_KEY=sk-ant-...            # not ANTHROPIC_API_KEY

# --- repo router (optional; defaults shown) ---
# Which model tier investigates: cheap = Haiku-class, strong = Opus-class (better on big specs, costs more)
# ROUTER_TIER=cheap
# Max model turns before the agent must answer from what it has found
# ROUTER_MAX_TURNS=12

# --- models behind the tiers (optional) ---
# LLM_CHEAP_MODEL=claude-haiku-4-5
# LLM_STRONG_MODEL=claude-opus-5

# --- where git-URL repos are cloned (optional) ---
# REPOS_DIR=~/.planning-pipeline/repos
